# ─────────────────────────────────────────────────────────────────────────────
# Files this tool produces that contain personal data
#
# offlist reads and writes things that describe a real person: which services
# hold their address, which have been breached, credentials exported from a
# password manager, saved mail. None of it belongs in a repository, and most of
# it would be worse to leak than ordinary source. These rules come first because
# they are the ones that matter.
# ─────────────────────────────────────────────────────────────────────────────

# Scan output: an address plus every service it is registered on.
offlist_*_results.csv
offlist_*_results.json
offlist-results/
scan-*.json
scan-*.csv

# The worklist itself -- a dossier of every service you use, which are breached,
# and which leak recovery identifiers. Normally lives under ~/.local/state, but
# XDG_STATE_HOME can point anywhere, including here.
worklist.json
.offlist-state/
offlist-state/
state/offlist/

# Generated deletion letters: your name, address, and the services involved.
offlist-letters/
*-deletion-request.txt

# Tier-A canary positives are literally "this address is registered at these
# sites". public_positives.yaml is committed on purpose; the local one never is.
offlist/catalogue/canary/local_positives.yaml
local_positives.yaml

# Password-manager and browser exports. These contain live credentials.
vault.csv
vault-*.csv
*vault*.csv
passwords.csv
*passwords*.csv
1password*.csv
bitwarden*.csv
lastpass*.csv
chrome-passwords*.csv
firefox-*.csv
keepass*.csv
export.csv
/*.csv

# Saved mail fed to `offlist act --mail`. Personal correspondence.
*.eml
*.mbox
*.mbx
mail/
maildir/
Maildir/

# Secrets: HIBP keys, OAuth client secrets, tokens for the Phase 8 mailbox scan.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
client_secret*.json
token.json
*token*.json
.hibp-key

# NOTE: deliberately no `!offlist/data/**` / `!offlist/catalogue/**` negation
# here. A broad re-include like that also un-ignores local_positives.yaml above,
# which is the single most sensitive file this tool produces. The shipped
# catalogue and broker snapshot need no negation anyway: `/*.csv` is
# root-anchored, and none of the rules above match their names.

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build
build/
dist/
sdist/
wheels/
develop-eggs/
downloads/
parts/
var/
*.egg-info/
*.egg
.eggs/
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ─────────────────────────────────────────────────────────────────────────────
# Testing, coverage, type checking, linting
# ─────────────────────────────────────────────────────────────────────────────
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
.hypothesis/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/
.pyre/

# The original author's uncommitted scratch tests, kept from the upstream repo.
test.py
test_module.py
todolist

# ─────────────────────────────────────────────────────────────────────────────
# Editors and OS
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.\#*
\#*\#
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Jupyter / notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Logs and scratch
*.log
logs/
tmp/
.tmp/
scratch/
